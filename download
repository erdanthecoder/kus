import { NextRequest, NextResponse } from 'next/server'
import { prisma } from '@/lib/db'
import { verifyToken } from '@/lib/auth'

export async function POST(req: NextRequest) {
  const auth = req.headers.get('authorization')
  if (!auth || !auth.startsWith('Bearer ')) {
    return NextResponse.json({ error: 'No token' }, { status: 401 })
  }
  const payload = verifyToken(auth.slice(7))
  if (!payload) {
    return NextResponse.json({ error: 'Invalid token' }, { status: 401 })
  }
  try {
    const { quizId, answers } = await req.json()
    const quiz = await prisma.quiz.findUnique({ where: { id: quizId } })
    if (!quiz) return NextResponse.json({ error: 'Quiz not found' }, { status: 404 })
    const questions = JSON.parse(quiz.questions)
    let score = 0
    answers.forEach((answer: number, i: number) => {
      if (questions[i] && answer === questions[i].correct) score++
    })
    const existing = await prisma.quizAttempt.findUnique({
      where: { userId_quizId: { userId: payload.id, quizId } },
    })
    if (existing) {
      const attempt = await prisma.quizAttempt.update({
        where: { id: existing.id },
        data: { score, answers: JSON.stringify(answers), completed: true },
      })
      return NextResponse.json({ score, total: questions.length, attempt })
    }
    const attempt = await prisma.quizAttempt.create({
      data: { userId: payload.id, quizId, score, total: questions.length, answers: JSON.stringify(answers), completed: true },
    })
    const starsEarned = Math.floor((score / questions.length) * 5)
    await prisma.user.update({
      where: { id: payload.id },
      data: { stars: { increment: starsEarned } },
    })
    return NextResponse.json({ score, total: questions.length, starsEarned, attempt })
  } catch (error) {
    return NextResponse.json({ error: 'Server error' }, { status: 500 })
  }
}

export async function GET(req: NextRequest) {
  const auth = req.headers.get('authorization')
  if (!auth || !auth.startsWith('Bearer ')) {
    return NextResponse.json({ error: 'No token' }, { status: 401 })
  }
  const payload = verifyToken(auth.slice(7))
  if (!payload) {
    return NextResponse.json({ error: 'Invalid token' }, { status: 401 })
  }
  const attempts = await prisma.quizAttempt.findMany({
    where: { userId: payload.id },
    include: { quiz: { select: { title: true, subject: true, year: true } } },
  })
  return NextResponse.json(attempts)
}