{
  "name": "bishkek-drive",
  "version": "1.0.0",
  "private": true,
  "description": "Bishkek Drive - open-world driving game on the real streets of Bishkek, Kyrgyzstan",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=es2020 --outfile=dist/game.js",
    "dev": "esbuild src/main.js --bundle --sourcemap --format=iife --target=es2020 --outfile=dist/game.js --servedir=. --watch"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "three": "^0.170.0"
  }
}
